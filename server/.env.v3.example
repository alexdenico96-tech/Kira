# Opcionais para a fase v3
# OPENAI_API_KEY=
OPENAI_SMALL_MODEL=gpt-4o-mini
OPENAI_CODE_MODEL=gpt-4o-mini
# GITHUB_TOKEN=   # necessário apenas para import/export GitHub
ROUTER_SMALL_CHAT_CHARS=1800
ROUTER_LARGE_ARTIFACT_CHARS=24000

# Kira v4 — provedores extras (todos opcionais)
# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Ordem e circuit breaker
EXTRA_PROVIDER_ORDER=cloudflare,mistral,openrouter
AI_PROVIDER_COOLDOWN_MS=600000

# Uma ou várias chaves Groq separadas por vírgula. GROQ_API_KEYS tem prioridade sobre GROQ_API_KEY.
GROQ_API_KEYS=

# Carrosséis (todas opcionais)
# KIRA_CAROUSEL_MAX_IMAGES=5        # imagens novas geradas no Cloudflare por carrossel (as fotos do usuário não contam)
# KIRA_CAROUSEL_MAX_ATTEMPTS=3      # revisões do roteiro contra o checklist do pedido
# KIRA_MAX_IMAGES_PER_MESSAGE=10    # fotos anexadas por mensagem
# KIRA_BODY_LIMIT=40mb              # tamanho máximo do envio (várias fotos)
